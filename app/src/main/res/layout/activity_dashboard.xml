<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F4"
    android:padding="5sp"
    tools:context=".DashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10sp"
        android:layout_marginTop="10sp"
        android:layout_marginRight="10sp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="10sp">

        <!-- Judul Dashboard -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:text="DASHBOARD"
            android:textColor="#FE5E7C4C"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Card Data: Nama Depan -->
        <!-- Menggunakan ID tvNamaDepan dan textView3, dimasukkan dalam card -->

        <!-- Card Data: Nama Belakang -->
        <!-- Menggunakan ID tvNamaBelakang dan textView6, dimasukkan dalam card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/textView10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textColor="#FE5E7C4C"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Email Pengguna"
                android:textColor="#070707"
                android:textSize="18sp"
                android:textStyle="normal" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/textView8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="#5E7C4C"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Username Pengguna"
                android:textColor="#0F0E0E"
                android:textSize="18sp"
                android:textStyle="normal" />
        </LinearLayout>

        <!-- Card Data: Username -->
        <!-- Menggunakan ID tvUsername dan textView8, dimasukkan dalam card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Depan"
                android:textColor="#5E7C4C"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNamaDepan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nama Depan"
                android:textColor="#050000"
                android:textSize="18sp"
                android:textStyle="normal" />
        </LinearLayout>

        <!-- Card Data: Email -->
        <!-- Menggunakan ID tvEmail dan textView10, dimasukkan dalam card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Belakang"
                android:textColor="#5E7C4C"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNamaBelakang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nama belakang"
                android:textColor="#0B0B0B"
                android:textSize="18sp"
                android:textStyle="normal" />
        </LinearLayout>

        <Button
            android:id="@+id/btnKeluar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#5E7C4C"
            android:paddingVertical="10sp"
            android:text="LOGOUT"
            android:textColor="#0A0A1F"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="20sp" />

    </LinearLayout>
</ScrollView>